{
  "name": "discord-workers-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fulldeploy": "npm run deploy && npm run register",
    "deploy": "wrangler deploy",
    "test": "wrangler dev --ip 0.0.0.0 --port 3000",
    "start": "npm test",
    "register": "node utils/registerCommands.js",
    "testregister": "node utils/registerCommands.js --debug",
    "unregister": "node utils/registerCommands.js --clean",
    "testunregister": "node utils/registerCommands.js --clean --debug",
    "prebuild": "node utils/preBuild.js",
    "secret": "wrangler secret bulk secrets.json"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "discord-api-types": "^0.38.53"
  }
}
